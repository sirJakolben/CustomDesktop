<?xml version="1.0" encoding="utf-8" ?>
<UserControl
    x:Class="CustomDesktop.Folder.FolderControl"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <!--
        Background="Transparent" required for hit-testing on empty areas.
        The outer Grid fills the full block size (set by GridCanvas in code-behind).
    -->
    <Grid
        x:Name="RootGrid"
        Background="Transparent"
        Tapped="RootGrid_Tapped"
        RightTapped="RootGrid_RightTapped"
        PointerPressed="RootGrid_PointerPressed"
        PointerMoved="RootGrid_PointerMoved"
        PointerReleased="RootGrid_PointerReleased"
        PointerCanceled="RootGrid_PointerCanceled">

        <!-- ── Context flyout ────────────────────────────────────────────────── -->
        <Grid.ContextFlyout>
            <MenuFlyout>
                <!-- Colour picker submenu -->
                <MenuFlyoutSubItem x:Name="ColorSubItem" Text="Farbe ändern">
                    <!-- Preset swatches + colour wheel button injected in code-behind -->
                </MenuFlyoutSubItem>
                <MenuFlyoutSeparator/>
                <MenuFlyoutItem
                    x:Name="DeleteFolderItem"
                    Text="Folder löschen"
                    Click="DeleteFolder_Click">
                    <MenuFlyoutItem.Foreground>
                        <SolidColorBrush Color="Red"/>
                    </MenuFlyoutItem.Foreground>
                </MenuFlyoutItem>
            </MenuFlyout>
        </Grid.ContextFlyout>

        <!-- ── Folder body ───────────────────────────────────────────────────── -->
        <Grid.RowDefinitions>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!--
            Coloured rounded background pill with a 2×2 icon preview grid.
            Background colour is set in code-behind from FolderModel.BackgroundColor.
        -->
        <Border
            x:Name="FolderBackground"
            Grid.Row="0"
            CornerRadius="14"
            Margin="6,6,6,3">

            <!-- 2×2 preview grid — up to 4 icons, unfilled slots stay empty -->
            <Grid Margin="8">
                <Grid.RowDefinitions>
                    <RowDefinition Height="*"/>
                    <RowDefinition Height="*"/>
                </Grid.RowDefinitions>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>

                <Image x:Name="Preview0" Grid.Row="0" Grid.Column="0"
                       Stretch="Uniform" Margin="2" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                <Image x:Name="Preview1" Grid.Row="0" Grid.Column="1"
                       Stretch="Uniform" Margin="2" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                <Image x:Name="Preview2" Grid.Row="1" Grid.Column="0"
                       Stretch="Uniform" Margin="2" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                <Image x:Name="Preview3" Grid.Row="1" Grid.Column="1"
                       Stretch="Uniform" Margin="2" HorizontalAlignment="Center" VerticalAlignment="Center"/>
            </Grid>
        </Border>

        <!-- Name label — double-click switches to rename TextBox -->
        <Border
            Grid.Row="1"
            Background="#66000000"
            CornerRadius="4"
            Padding="4,1"
            Margin="4,0,4,6"
            HorizontalAlignment="Center"
            MaxWidth="140">

            <Grid>
                <TextBlock
                    x:Name="NameLabel"
                    TextAlignment="Center"
                    TextWrapping="Wrap"
                    MaxLines="2"
                    TextTrimming="CharacterEllipsis"
                    FontSize="11"
                    Foreground="White"
                    DoubleTapped="NameLabel_DoubleTapped"/>

                <!-- Rename TextBox — hidden unless user double-clicks the label -->
                <TextBox
                    x:Name="NameTextBox"
                    Visibility="Collapsed"
                    FontSize="11"
                    TextAlignment="Center"
                    Background="Transparent"
                    Foreground="White"
                    BorderThickness="0"
                    Padding="0"
                    LostFocus="NameTextBox_LostFocus"
                    KeyDown="NameTextBox_KeyDown"/>
            </Grid>
        </Border>

    </Grid>
</UserControl>
