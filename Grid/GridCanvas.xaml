<?xml version="1.0" encoding="utf-8" ?>
<UserControl
    x:Class="CustomDesktop.Grid.GridCanvas"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <!--
        Transparent background is mandatory: without it the Canvas receives no
        pointer events on empty areas.
    -->
    <Grid>

        <!-- Primary layer: items, folders, hover indicator -->
        <Canvas
            x:Name="LayerCanvas"
            HorizontalAlignment="Stretch"
            VerticalAlignment="Stretch"
            Background="Transparent"
            PointerPressed="LayerCanvas_PointerPressed"
            PointerMoved="LayerCanvas_PointerMoved"
            PointerReleased="LayerCanvas_PointerReleased"
            PointerCanceled="LayerCanvas_PointerCanceled"
            PointerExited="LayerCanvas_PointerExited"
            RightTapped="LayerCanvas_RightTapped">

            <!--
                Rubber-band selection box.
                Shown when the user LMB/RMB-drags on an empty area.
                Aligns to grid cell boundaries.
                IsHitTestVisible=False so it never intercepts events.
            -->
            <Border
                x:Name="SelectionBox"
                BorderBrush="#668FE1FF"
                BorderThickness="1"
                Background="#228FE1FF"
                CornerRadius="2"
                IsHitTestVisible="False"
                Visibility="Collapsed"
                Canvas.ZIndex="50" />

        </Canvas>

        <!--
            Drag overlay: normally transparent and non-hit-testable.
            DragManager sets IsHitTestVisible=True during a drag to capture
            all pointer events; ghost and snap indicator are placed here.
            ResizeManager places corner handles here (always on top).
        -->
        <Canvas
            x:Name="DragOverlayCanvas"
            HorizontalAlignment="Stretch"
            VerticalAlignment="Stretch"
            Background="Transparent"
            IsHitTestVisible="False" />

    </Grid>
</UserControl>
