<?xml version="1.0" encoding="utf-8" ?>
<Window
    x:Class="CustomDesktop.MainWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:local="using:CustomDesktop"
    xmlns:grid="using:CustomDesktop.Grid"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    mc:Ignorable="d">
    <!--
        No SystemBackdrop: we need a fully transparent window so the real Windows
        desktop (wallpaper, slideshows) shows through beneath the grid overlay.
        MicaBackdrop was removed in Phase 6.
    -->

    <Grid x:Name="RootGrid" Background="Transparent">
        <grid:GridCanvas x:Name="DesktopGrid" />
    </Grid>
</Window>
