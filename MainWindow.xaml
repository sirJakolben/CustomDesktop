<?xml version="1.0" encoding="utf-8" ?>
<Window
    x:Class="CustomDesktop.MainWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:local="using:CustomDesktop"
    xmlns:grid="using:CustomDesktop.Grid"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    mc:Ignorable="d">
    <Window.SystemBackdrop>
        <MicaBackdrop />
    </Window.SystemBackdrop>

    <Grid x:Name="RootGrid">
        <!-- Phase 2: Grid canvas — hover detection, slot snapping, right-click passthrough -->
        <grid:GridCanvas x:Name="DesktopGrid" />
    </Grid>
</Window>
